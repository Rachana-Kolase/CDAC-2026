//Building Sensor Grid

#include <iostream>
using namespace std;

int main() {
    double temp[3][3];

    // To Read input values for 9 rooms
    cout << "Enter 9 temperature values:\n";
    for (int f = 0; f < 3; f++) {
        for (int r = 0; r < 3; r++) {
            cin >> temp[f][r];
        }
    }

    //to track results
    double maxTemp = temp[0][0];
    int maxF = 0, maxR = 0;

    double maxAvg = -1.0;
    int hottestFloor = 0;

    int warningCount = 0;

    //Display table
    cout << "\n\tRoom1\tRoom2\tRoom3\n";
    for (int f = 0; f < 3; f++) {
        cout << "Floor " << (f + 1) << " : ";
        double sum = 0;

        for (int r = 0; r < 3; r++) {
            double val = temp[f][r];
            cout << val << "\t";

            // To Track highest room temperature
            if (val > maxTemp) {
                maxTemp = val;
                maxF = f;
                maxR = r;
            }

            // To Count warnings (>= 30°C)
            if (val >= 30.0) {
                warningCount++;
            }

            sum += val;
        }

        // Check highest floor average
        double avg = sum / 3.0;
        if (avg > maxAvg) {
            maxAvg = avg;
            hottestFloor = f;
        }

        cout << endl;
    }

    // To *Print final report
    cout << "\nHottest Room   : Floor " << (maxF + 1) << ", Room " << (maxR + 1) << " -> " << maxTemp << "°C\n";
    cout << "Hottest Floor  : Floor " << (hottestFloor + 1) << " (avg " << maxAvg << "°C)\n";
    cout << "Rooms at WARNING or above : " << warningCount << endl;

    return 0;
}


