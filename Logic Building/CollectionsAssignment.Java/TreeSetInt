package org.rachana;
import java.util.TreeSet;
public class TreeSetInt {

	public static void main(String[] args) {
		TreeSet<Integer> list=new TreeSet<>();
		list.add(10);
		list.add(20);
		list.add(30);
		list.add(40);
		list.add(50);
		//Write a Java program to get the element in a tree set which is greater than or equal to the given element. (Hint : Use the ceiling method of the TreeSet)
		
		System.out.println(list.ceiling(25));
	}
}

